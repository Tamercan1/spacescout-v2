# ==============================================================================
# SpaceScout V2 — Landing Application Environment Configuration
# ==============================================================================
# Copy this file to .env.local for local overrides.
# NEVER commit .env.local or secret keys to version control.

# ==============================================================================
# Server-Only NASA API Key (Request-Time SSR)
# ==============================================================================
# Used by Next.js Server Components to fetch astronomy content at request-time.
# Optional for development: If omitted or set to DEMO_KEY, the app uses NASA's DEMO_KEY
# (rate-limited to 30 req/hr) or falls back to public NASA Science endpoints.
# In production on Vercel, provide a valid API key from https://api.nasa.gov/.
# SECURITY NOTE: Do NOT prefix with NEXT_PUBLIC_. This secret must remain server-side.
NASA_API_KEY=DEMO_KEY

# ==============================================================================
# Public Application & Site URLs
# ==============================================================================
# URL of the existing deployed SpaceScout React application (Vite SPA).
# Used by CTA buttons ("Launch App", "Start Exploring", "Sign In", prompt handoff).
# - Development default: http://localhost:5173
# - Production fallback: https://spacescout.vercel.app (used automatically if unset)
NEXT_PUBLIC_APP_URL=http://localhost:5173

# Canonical URL of this landing website.
# Used for SEO canonical tags, Open Graph meta tags, and sitemap generation.
# - Development default: http://localhost:3000
# - Production: Leave unset until the dedicated marketing domain is chosen.
#   When unset in production, canonical/sitemap gracefully omit speculative domains.
# NEXT_PUBLIC_SITE_URL=https://spacescout.app

# Optional repository URL override (defaults to https://github.com/Tamercan1/spacescout-v2)
# NEXT_PUBLIC_GITHUB_URL=https://github.com/Tamercan1/spacescout-v2
