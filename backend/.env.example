# SpaceScout V2 — Backend Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Django secret key — generate a strong random value for production.
# If omitted, a random key is generated at startup (development only).
DJANGO_SECRET_KEY=

# Debug mode — set to True for local development, False for production.
DEBUG=True

# Comma-separated list of allowed hostnames.
# Production example: ALLOWED_HOSTS=spacescout.example.com
ALLOWED_HOSTS=localhost,127.0.0.1

# OpenRouter API key for LLM access.
OPENROUTER_API_KEY=

# Optional: specific LLM model to use via OpenRouter.
# If omitted, falls back to openrouter/free.
# LLM_MODEL=

# NASA API key. Get one at https://api.nasa.gov/
# DEMO_KEY works but has low rate limits (30 req/hour).
NASA_API_KEY=DEMO_KEY

# Encryption key for BYOK credentials. Must be a 32-url-safe base64-encoded bytes string.
# Generate via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=