# SpaceScout V2 — Backend Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env or real secrets to version control.

# ==============================================================================
# Core Django Settings
# ==============================================================================

# Debug mode — set to True for local development, False for production.
# When DEBUG=False, security checks, persistent encryption keys, and secure cookies are enforced.
DEBUG=True

# Django secret key:
# - Local: If omitted, a development key is auto-generated at startup.
# - Production (DEBUG=False): REQUIRED. Set to a strong random 50+ character string.
DJANGO_SECRET_KEY=

# Allowed Hostnames:
# Comma-separated list of hostnames/domains this Django service will serve.
# Local default: localhost, 127.0.0.1
# Production example: spacescout-backend.onrender.com
ALLOWED_HOSTS=localhost,127.0.0.1

# ==============================================================================
# Production HTTPS & Security Settings
# ==============================================================================

# HTTPS Redirect:
# Automatically redirects HTTP requests to HTTPS behind Render's TLS-terminating proxy.
# Defaults to True in production. Note: /api/health/ and /health/ are specifically exempt
# so container health check probes do not receive 301 redirects.
# SECURE_SSL_REDIRECT=True

# HSTS (HTTP Strict Transport Security):
# For initial deployment on provider-assigned subdomains (*.onrender.com), HSTS defaults
# to 0 (disabled). Enabling 1-year HSTS prematurely can cause persistent browser lockouts
# if certificate or proxy configuration issues occur.
# Once live HTTPS and custom domain routing are verified:
# 1. Start with a short test duration: SECURE_HSTS_SECONDS=3600 (1 hour)
# 2. Once verified stable, set production value: SECURE_HSTS_SECONDS=31536000 (1 year)
# 3. Optionally enable subdomains and preload once production domain is finalized:
#    SECURE_HSTS_INCLUDE_SUBDOMAINS=True
#    SECURE_HSTS_PRELOAD=True
# SECURE_HSTS_SECONDS=0

# ==============================================================================
# Database Configuration
# ==============================================================================

# Database connection URL:
# - Local: Leave commented/empty to use local SQLite (backend/db.sqlite3).
# - Production (Aiven PostgreSQL): REQUIRED.
# Format: postgres://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
# Note: SSL is required by Aiven and enforced by backend settings.
# DATABASE_URL=postgres://avnadmin:your-password@spacescout-db.aivencloud.com:15432/defaultdb?sslmode=require

# ==============================================================================
# Cross-Origin (CORS) & CSRF Configuration
# ==============================================================================

# Comma-separated origins allowed to make API requests from browser clients.
# Local development default includes http://localhost:5173, http://127.0.0.1:5173
# Production (Vercel frontend): set to your Vercel deployment URL(s).
# CORS_ALLOWED_ORIGINS=https://spacescout.vercel.app,https://spacescout-preview.vercel.app

# Comma-separated origins trusted for unsafe HTTP requests (POST, PUT, DELETE).
# CSRF_TRUSTED_ORIGINS=https://spacescout.vercel.app,https://spacescout-preview.vercel.app

# ==============================================================================
# Credential Encryption (BYOK Security)
# ==============================================================================

# 32 url-safe base64-encoded bytes string used to encrypt user BYOK API keys in DB.
# Generate via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# - Local: If omitted, a temporary development key is used.
# - Production (DEBUG=False): STRICTLY REQUIRED on startup.
# CRITICAL: This key MUST persist across restarts and redeployments.
# If this key changes or is lost, previously encrypted user API keys cannot be decrypted.
CREDENTIAL_ENCRYPTION_KEY=

# ==============================================================================
# External APIs & AI Providers
# ==============================================================================

# Server Fallback OpenRouter API key:
# - Users can configure their own BYOK (Bring Your Own Key) in Settings.
# - If a user does NOT have a BYOK key configured, this server key is used as fallback.
# - If exhausted or unconfigured, users receive a clear prompt to enter their own key in Settings.
OPENROUTER_API_KEY=

# Optional model override (defaults to openrouter/free if omitted).
# LLM_MODEL=openrouter/free

# NASA API key:
# Used by NASA tool clients (APOD, Mars Rover Photos, EPIC, etc.)
# Get a key at https://api.nasa.gov/. DEMO_KEY works locally but is rate-limited (30 req/hr).
NASA_API_KEY=DEMO_KEY

# ==============================================================================
# Production Server & Health Check Reference
# ==============================================================================
# Render Start Command:
#   gunicorn config.wsgi:application --workers 2 --threads 4 --timeout 120 --bind 0.0.0.0:$PORT
#   - Workers/Threads: 2 workers with 4 threads provide balanced concurrency on 512MB RAM instances.
#   - Timeout: 120s accommodates multi-step AI planner executions and NASA client calls.
#
# Health Check Endpoint:
#   GET /api/health/ (or GET /health/)
#   - Unauthenticated, returns HTTP 200 with {"status": "healthy", "database": "connected"}
#   - Returns HTTP 503 if database connectivity fails.
#   - Safe for Render health checks and uptime monitors; leaks no internal details.